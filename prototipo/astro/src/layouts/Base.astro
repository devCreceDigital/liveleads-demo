---
import '../styles/global.css';
import Overlays from '../components/Overlays.astro';
interface Props { view: string; title: string }
const { view, title } = Astro.props;
const routes = {"login": "/", "registro": "/registro", "verificar": "/verificar", "ob-etiquetas": "/bienvenida/etiquetas", "ob-tiktok": "/bienvenida/live", "live": "/live", "rescatar": "/por-rescatar", "historial": "/historial", "etiquetas": "/etiquetas", "catalogo": "/catalogo", "perfil": "/perfil"};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · LiveLeads</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap">
  </head>
  <body>
    <slot />
    <Overlays />
    <script is:inline define:vars={{ view, routes }}>window.LL_START = view; window.LL_ROUTES = routes;</script>
    <script is:inline src="/proto.js"></script>
  </body>
</html>
