---
---
<div class="auth" data-view="registro">
  <form class="auth-box" id="f-reg" novalidate>
    <div class="brand"><span class="ll">LL</span>LiveLeads</div>
    <div class="steps"><i class="on"></i><i></i><i></i><i></i></div>
    <div class="card top">
      <h1>Crea tu cuenta</h1>
      <p class="muted" style="margin:0"><b>7 días gratis.</b> Sin tarjeta. Te toma 2 minutos.</p>
      <label class="field"><span>Tu @ de TikTok</span><input class="in" id="r-tt" placeholder="@tutienda"><span class="help">La cuenta desde la que haces tus lives.</span></label>
      <label class="field"><span>Correo</span><input class="in" id="r-mail" type="email" placeholder="tienda@correo.com"></label>
      <label class="field"><span>Contraseña</span><input class="in" id="r-pass" type="password" placeholder="Mínimo 8 caracteres"></label>
      <span class="help err" id="r-err" hidden></span>
      <button class="btn block" type="submit">Crear cuenta</button>
    </div>
    <p class="foot">¿Ya tienes cuenta? <button class="link" type="button" data-go="login">Inicia sesión</button></p>
  </form>
</div>
