      <input class="in" id="res-q" placeholder="Buscar @usuario o comentario">
      <div class="chips" id="res-state">
        <button class="chip on" data-st="todos">Todos</button><button class="chip" data-st="pendiente">Por escribir</button><button class="chip" data-st="escrito">Escritos</button><button class="chip" data-st="whatsapp">En WhatsApp</button>
      </div>
      <div class="chips" id="res-tags"></div>
      <div class="card slim" style="padding:8px 4px" id="res-list"></div>
    </div>
