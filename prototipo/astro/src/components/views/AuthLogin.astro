---
---
<div class="auth" data-view="login">
  <form class="auth-box" id="f-login" novalidate>
    <div class="brand"><span class="ll">LL</span>LiveLeads</div>
    <div class="card top">
      <h1>¡Hola de nuevo!</h1>
      <label class="field"><span>Tu @ de TikTok o correo</span><input class="in" id="l-user" placeholder="@tutienda" autocomplete="username"></label>
      <label class="field"><span>Contraseña</span><input class="in" id="l-pass" type="password" placeholder="••••••••" autocomplete="current-password"></label>
      <span class="help err" id="l-err">Escribe tu @ o correo y tu contraseña.</span>
      <button class="btn block" type="submit">Iniciar sesión</button>
      <button class="link" type="button" data-toast="Te enviamos un código a tu correo">¿Olvidaste tu clave? Entra con un código</button>
    </div>
    <p class="foot">¿No tienes cuenta? <button class="link" type="button" data-go="registro">Crea tu cuenta gratis</button></p>
  </form>
</div>
